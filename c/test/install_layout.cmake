# Installs the build tree BUILD (configuration CONFIG) under PREFIX with
# `cmake --install` and requires exactly the files and links that EXPECTED
# (install_layout.txt) lists for LAYOUT.  A file listed as "names X" must
# record X as its own name or as a library it loads, read with OBJDUMP
# (objdump -p: SONAME, NEEDED, DLL Name), OTOOL (otool -L) or DUMPBIN
# (dumpbin /dependents).  An absolute install directory would put files
# outside PREFIX, so the test then reports itself skipped.
# usage: cmake -DBUILD=... -DCONFIG=... -DPREFIX=... -DLAYOUT=... -DEXPECTED=...
#              -DBINDIR=... -DLIBDIR=... -DINCLUDEDIR=... -DMANDIR=... -DFULL_LIBDIR=...
#              [-DPOSTFIX=d] (-DOBJDUMP=... | -DOTOOL=... | -DDUMPBIN=...) -P install_layout.cmake
foreach(_dir BINDIR LIBDIR INCLUDEDIR MANDIR)
  if(IS_ABSOLUTE "${${_dir}}")
    message("install_layout: skipped: CMAKE_INSTALL_${_dir} (${${_dir}}) is absolute")
    return()
  endif()
endforeach()

if(NOT IS_ABSOLUTE "${PREFIX}")
  message(FATAL_ERROR "PREFIX must be an absolute directory")
endif()
file(REMOVE_RECURSE ${PREFIX})
execute_process(COMMAND ${CMAKE_COMMAND} --install ${BUILD} --config ${CONFIG} --prefix ${PREFIX}
                OUTPUT_VARIABLE _log ERROR_VARIABLE _log RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "cmake --install failed:\n${_log}")
endif()

# The expected entries, as "path" or "path -> target", and the names to find.
file(STRINGS ${EXPECTED} _lines REGEX "^[^# \t]")
set(_want "")
set(_checks "")
foreach(_line IN LISTS _lines)
  string(STRIP "${_line}" _line)
  string(REGEX REPLACE "[ \t]+" ";" _fields "${_line}")
  list(GET _fields 0 _layouts)
  string(REPLACE "," ";" _layouts "${_layouts}")
  list(FIND _layouts ${LAYOUT} _i)
  if(_i EQUAL -1)
    continue()
  endif()
  string(CONFIGURE "${_fields}" _fields @ONLY)
  list(GET _fields 1 _path)
  list(LENGTH _fields _n)
  if(_n EQUAL 2)
    list(APPEND _want "${_path}")
    continue()
  endif()
  list(GET _fields 2 _kind)
  list(GET _fields -1 _arg)
  if(_n EQUAL 4 AND _kind STREQUAL "->")
    list(APPEND _want "${_path} -> ${_arg}")
  elseif(_n EQUAL 4 AND _kind STREQUAL "names")
    list(APPEND _want "${_path}")
    list(APPEND _checks "${_path}|${_arg}")
  else()
    message(FATAL_ERROR "${EXPECTED}: unreadable line: ${_line}")
  endif()
endforeach()
if(NOT _want)
  message(FATAL_ERROR "${EXPECTED} lists nothing for the layout ${LAYOUT}")
endif()

file(GLOB_RECURSE _files LIST_DIRECTORIES false RELATIVE ${PREFIX} ${PREFIX}/*)
set(_got "")
foreach(_path IN LISTS _files)
  if(IS_SYMLINK ${PREFIX}/${_path})
    file(READ_SYMLINK ${PREFIX}/${_path} _target)
    list(APPEND _got "${_path} -> ${_target}")
  else()
    list(APPEND _got "${_path}")
  endif()
endforeach()
set(_missing "")
foreach(_entry IN LISTS _want)
  list(FIND _got "${_entry}" _i)
  if(_i EQUAL -1)
    string(APPEND _missing "\n  ${_entry}")
  endif()
endforeach()
set(_extra "")
foreach(_entry IN LISTS _got)
  list(FIND _want "${_entry}" _i)
  if(_i EQUAL -1)
    string(APPEND _extra "\n  ${_entry}")
  endif()
endforeach()
if(_missing OR _extra)
  message(FATAL_ERROR "the installed files differ from the ${LAYOUT} layout\n"
                      "missing:${_missing}\nnot expected:${_extra}")
endif()

foreach(_check IN LISTS _checks)
  string(REPLACE "|" ";" _check "${_check}")
  list(GET _check 0 _path)
  list(GET _check 1 _name)
  # The name is the regular expression's group number _group.
  if(DUMPBIN)
    execute_process(COMMAND ${DUMPBIN} /nologo /dependents ${PREFIX}/${_path} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
    set(_regex "^ +([^ ]+[.][Dd][Ll][Ll])$")
    set(_group 1)
  elseif(OTOOL)
    execute_process(COMMAND ${OTOOL} -L ${PREFIX}/${_path} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
    set(_regex "^[ \t]+(.+) [(]compatibility version")
    set(_group 1)
  elseif(OBJDUMP)
    execute_process(COMMAND ${OBJDUMP} -p ${PREFIX}/${_path} OUTPUT_VARIABLE _out RESULT_VARIABLE _rc)
    set(_regex "^[ \t]*(SONAME|NEEDED|DLL Name:)[ \t]+(.+)$")
    set(_group 2)
  else()
    message(FATAL_ERROR "the names need OBJDUMP, OTOOL or DUMPBIN")
  endif()
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "reading ${_path} failed")
  endif()
  string(REPLACE "\r" "" _out "${_out}")
  string(REPLACE "\n" ";" _out "${_out}")
  set(_names "")
  foreach(_line IN LISTS _out)
    if(_line MATCHES "${_regex}")
      list(APPEND _names "${CMAKE_MATCH_${_group}}")
    endif()
  endforeach()
  list(FIND _names "${_name}" _i)
  if(_i EQUAL -1)
    message(FATAL_ERROR "${_path} does not name ${_name}; it names: ${_names}")
  endif()
endforeach()
list(LENGTH _got _n)
list(LENGTH _checks _c)
message(STATUS "${_n} files and links installed as the ${LAYOUT} layout lists them; ${_c} library names found")
